# ..........Insertion Sort Algorithm ......#

n = int(input("Enter the number of elements: "))

arr = []

print("Enter the elements:")
for i in range(n):
    element = int(input())
    arr.append(element)

for i in range(1, n):
    key = arr[i]
    j = i - 1

    while j >= 0 and arr[j] > key:
        arr[j + 1] = arr[j]
        j -= 1

    arr[j + 1] = key

print("\nSorted Array:")
for i in arr:
    print(i, end=" ")

print("\n\nTime Complexity : O(n²)")
print("Space Complexity: O(1)")
